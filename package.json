{
  "name": "link-router",
  "version": "0.1.1",
  "description": "Obsidian plugin for routing specially delimited web links to configurable actions.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "link-routing",
    "links"
  ],
  "author": "Adam Fried-Gintis <github@afg.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamF-G/obsidian-link-router.git"
  },
  "bugs": {
    "url": "https://github.com/AdamF-G/obsidian-link-router/issues"
  },
  "homepage": "https://github.com/AdamF-G/obsidian-link-router#readme",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^16.0.0",
    "obsidian": "latest",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
